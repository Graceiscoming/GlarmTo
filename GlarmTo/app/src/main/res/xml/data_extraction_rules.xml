<?xml version="1.0" encoding="utf-8"?>
<!--
   Automatic backup is turned off in the manifest (allowBackup="false"): the database holds the
   password hashes and all training data, and users have JSON/CSV export for their own backups.
   These rules keep cloud backup and device-to-device transfer from copying it if that ever changes.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
