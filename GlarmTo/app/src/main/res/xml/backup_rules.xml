<?xml version="1.0" encoding="utf-8"?>
<!--
   Automatic backup is turned off in the manifest (allowBackup="false"): the database holds the
   password hashes and all training data, and users have JSON/CSV export for their own backups.
   These rules keep it that way for any tool that still reads them (API 30 and older).
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
